{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qernelkit/weakcrypto/schema/target.schema.json",
  "title": "A repository in the scan queue",
  "description": "repos/<owner>/<repo>/repo.json: a repository to scan. Adding the file queues it.",
  "type": "object",
  "required": [
    "schema",
    "repo",
    "url",
    "addedBy",
    "addedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "weakcrypto.target/v1"
    },
    "repo": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Pinned when the repository is first scanned."
    },
    "justification": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Why it belongs: what it is and why its cryptography matters."
    },
    "stars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "addedBy": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,39}$"
    },
    "addedAt": {
      "type": "string",
      "format": "date-time"
    },
    "via": {
      "type": "string",
      "enum": [
        "pull-request",
        "site",
        "corpus"
      ],
      "description": "A pull request, the Add box on the site (through the bot), or the 100+ star corpus."
    }
  }
}
